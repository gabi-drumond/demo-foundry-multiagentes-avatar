# ==== Microsoft Foundry (orchestrator) ====
# Required: project endpoint from ai.azure.com > project > Overview
FOUNDRY_PROJECT_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/api/projects/<project-name>

# Published agents (keep these defaults unless you used different names)
AGENTE_PRODUCTO=agente-producto
AGENTE_PRODUCTO_VERSION=1
AGENTE_CUMPLIMIENTO=agente-cumplimiento-riesgo
AGENTE_CUMPLIMIENTO_VERSION=1

# Orchestrator model deployment
FOUNDRY_MODEL=gpt-5

# ==== Azure AI Speech (voice and avatar) ====
# Required for voice and avatar
SPEECH_REGION=<region>
SPEECH_ENDPOINT=https://<speech-resource>.cognitiveservices.azure.com

# Optional. Leave empty to use DefaultAzureCredential after `az login`.
SPEECH_KEY=

# Optional UI defaults
SPEECH_VOICE=es-MX-DaliaNeural
AVATAR_CHARACTER=lisa
AVATAR_STYLE=casual-sitting

# ==== Optional Azure API Management AI Gateway ====
# Leave APIM_GATEWAY_URL and all APIM keys empty to use Foundry directly.
APIM_GATEWAY_URL=
APIM_DEPLOYMENT=gpt-5
APIM_API_VERSION=2025-04-01-preview
APIM_KEY_BANCA_RETAIL=
APIM_KEY_BANCA_PYME=
APIM_KEY_BANCA_EMPRESARIAL=

# ==== Optional AI FinOps pricing ====
# `retail` queries the public Azure Retail Prices API; `fixed` uses the fallback values.
FINOPS_PRICE_SOURCE=retail
FINOPS_PRICE_INPUT_PER_1M=1.25
FINOPS_PRICE_OUTPUT_PER_1M=10.0
FINOPS_METER_INPUT=gpt-5-codex-inp-glbl
FINOPS_METER_OUTPUT=gpt-5-codex-out-glbl
