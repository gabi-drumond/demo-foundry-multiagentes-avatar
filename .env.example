# ==== Azure AI Foundry (orquestador) ====
# OBLIGATORIO: endpoint del proyecto Foundry (ai.azure.com > proyecto > Overview)
FOUNDRY_PROJECT_ENDPOINT=https://<recurso-foundry>.services.ai.azure.com/api/projects/<proyecto>

# Agentes publicados en el portal (dejar el default si no cambiaste los nombres)
AGENTE_PRODUCTO=agente-producto
AGENTE_PRODUCTO_VERSION=1
AGENTE_CUMPLIMIENTO=agente-cumplimiento-riesgo
AGENTE_CUMPLIMIENTO_VERSION=1

# Modelo del orquestador (chat/síntesis)
FOUNDRY_MODEL=gpt-5

# ==== Azure AI Speech (avatar de voz) ====
# OBLIGATORIO para voz/avatar
SPEECH_REGION=<region>
SPEECH_ENDPOINT=https://<recurso-speech>.cognitiveservices.azure.com

# Opcional: si defines SPEECH_KEY usa la key; si lo dejas vacío usa DefaultAzureCredential (az login)
SPEECH_KEY=

# Opcionales (defaults del app)
SPEECH_VOICE=es-MX-DaliaNeural
AVATAR_CHARACTER=lisa
AVATAR_STYLE=casual-sitting
